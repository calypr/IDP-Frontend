{
  "name": "gen3-frontend-framework",
  "version": "0.11.16",
  "description": "The Gen3 Frontend Framework mono repo for Gen 3.2 development",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/frontend",
    "packages/storybook",
    "packages/tools",
    "packages/sampleCommons"
  ],
  "engines": {
    "npm": ">=10.2.3",
    "node": ">=22.11.0"
  },
  "scripts": {
    "lint": "lerna run lint",
    "lint-fix": "eslint . --fix",
    "lint:config": "npx @eslint/config-inspector@latest",
    "oxlint": "oxlint .",
    "build": "lerna run build --include-dependencies --stream",
    "build:pkg": "lerna run build --include-dependencies --stream --ignore=@gen3/samplecommons",
    "build:clean": "lerna run build:clean",
    "compile": "lerna run compile",
    "dev": "NODE_OPTIONS='--max_old_space_size=4096' lerna run dev",
    "dev:watch": "lerna watch -- lerna run dev --scope=\\$LERNA_PACKAGE_NAME --include-dependencies",
    "dev:app": "lerna run dev --scope=@gen3/samplecommons",
    "start": "lerna run start",
    "storybook": "lerna run storybook --scope @gen3/storybook",
    "build:start": "npm run build && npm run start",
    "setProxy": "(cd ./packages/tools/localDev/nginx/; ./configureNginx.sh -d $npm_config_domain)",
    "test": "npm run test --workspaces",
    "test:int": "npm run test:int --workspaces",
    "test:all": "npm run test:all --workspaces"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource/lato": "^5.2.7",
    "@grafana/faro-react": "^2.2.4",
    "@grafana/faro-web-sdk": "^2.2.4",
    "@grafana/faro-web-tracing": "^2.2.4",
    "@iconify/react": "^6.0.2",
    "@mantine/core": "^8.3.15",
    "@mantine/dates": "^8.3.15",
    "@mantine/form": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "@xyflow/react": "^12.10.1",
    "classnames": "^2.5.1",
    "colorette": "^2.0.20",
    "cookies-next": "6.1.1",
    "d3": "^7.9.0",
    "echarts-for-react": "^3.0.6",
    "idb": "^8.0.3",
    "isomorphic-fetch": "^3.0.0",
    "jsonpath-plus": "10.4.0",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-complex-tree": "^2.6.1",
    "react-dom": "^19.2.4",
    "react-plotly.js": "^2.6.0",
    "react-responsive-carousel": "^3.2.23",
    "url-join": "^5.0.0",
    "victory-chart": "^37.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@eslint/js": "^9.10.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "25.3.0",
    "@types/react": "^19.2.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.10.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.2.10",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "lerna": "^9.0.4",
    "msw": "^2.12.10",
    "nx": "22.7.5",
    "oxlint": "^1.49.0",
    "postcss-import": "^16.1.1",
