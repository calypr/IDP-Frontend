{
  "name": "@gen3/frontend",
  "version": "0.11.32",
  "description": "Gen3 frontend components, content management, and pages",
  "keywords": [],
  "author": "Center for Translational Data Science",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "npm": ">=10.2.3",
    "node": ">=22.11.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "compile": "node ../../node_modules/@typescript/native/bin/tsc",
    "clean": "rm -rf dist",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "jest unit",
    "test:watch": "jest unit --watch",
    "test:int": "echo No integrations tests yet",
    "test:all": "jest",
    "types": "node ../../node_modules/@typescript/native/bin/tsc --emitDeclarationOnly",
    "copy-tailwind": "cp src/tailwind.cjs dist/tailwind.cjs",
    "build": "npm run compile && npm run types && npm run rollup",
    "build:clean": "npm run clean && npm run build",
    "build:watch": "npm run compile --stream && npm run rollup -- --watch",
    "dev": "npm run build:watch",
    "devssh": "npm run dev"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "style": "dist/styles.css",
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
