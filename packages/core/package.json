{
  "name": "@gen3/core",
  "version": "0.11.32",
  "author": "CTDS",
  "description": "Core module for Gen3.2. Packages provides an interface for interacting with the gen3 API, various types, and a redux store for managing state.",
  "license": "Apache-2.0",
  "engines": {
    "npm": ">=10.8.2",
    "node": ">=22.11.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "compile": "node ../../node_modules/@typescript/native/bin/tsc",
    "clean": "rm -rf dist",
    "types": "node ../../node_modules/@typescript/native/bin/tsc --emitDeclarationOnly --skipLibCheck",
    "build": "npm run clean && npm run compile && rollup --config rollup.config.mjs",
    "build:clean": "npm run clean && npm run compile && npm run types && rollup --config rollup.config.mjs",
    "build:watch": "npm run compile && rollup --config rollup.config.mjs --watch",
    "test": "jest unit",
    "test:watch": "jest unit --watch",
    "test:int": "jest int",
    "test:all": "jest",
    "dev": "npm run build:watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-cookie": "^8.0.1",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@swc/wasm": "^1.15.11",
    "@testing-library/react": "^16.3.2",
    "@types/estree": "^1.0.8",
    "@types/fastestsmallesttextencoderdecoder": "^1.0.2",
    "@types/flat": "^5.0.5",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/lodash": "^4.17.23",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^11.0.0",
    "fake-indexeddb": "^6.2.5"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "flat": "^6.0.1",
    "papaparse": "^5.5.3",
    "queue": "7.0.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "swr": "^2.4.0",
    "uuid": "^13.0.0"
  },
  "files": [
    "dist"
  ]
}
